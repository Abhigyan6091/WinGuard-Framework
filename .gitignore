# Binaries and compiled objects
bin/*.exe
bin/*.pdb
bin/*.ilk
*.obj
*.o

# Ephemeral runtime telemetry logs and crash dumps
results/telemetry_pid*.csv
results/test_*_telemetry.csv
results/crash_dumps/*.dmp
!results/crash_dumps/.gitkeep

# Sandbox runtime outputs
sandbox/output/*
sandbox/temp/*
!sandbox/output/.gitkeep
!sandbox/temp/.gitkeep
!sandbox/input/.gitkeep

# IDE and OS
.vscode/
.vs/
*.swp
*.DS_Store
Thumbs.db

# Internal audit, defense notes and private documentation
docs/deep_dive.md
docs/*deep_dive*.md
docs/viva.md
docs/limitations.md

# Generated reports & presentation documents
*.pdf


