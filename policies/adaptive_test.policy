# WinGuard Security Policy: Adaptive Fast Test
[metadata]
name = adaptive_test
version = 1.0.0
author = WinGuard Team
description = Adaptive state machine test policy with 1s decay interval and fast escalation

[security]
initial_level = LEVEL_0_OBSERVE

[limits]
max_processes = 5
max_memory_mb = 20
cpu_rate_cap_percent = 10
cpu_hard_cap = true

[token]
use_restricted_token = false
strip_admin_sids = true
disable_all_privileges = false
integrity_level = Medium

[filesystem]
sandbox_root = sandbox
read_only_paths = sandbox\input
read_write_paths = sandbox\output;sandbox\temp
denied_paths = C:\Windows;C:\Program Files

[adaptive]
escalation_threshold = 2
decay_interval_sec = 1
decay_step = 1
auto_terminate_on_l3 = false
