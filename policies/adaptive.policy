# WinGuard Security Policy: Adaptive
# Purpose: Dynamic policy starting in observation and escalating limits upon violation

[metadata]
name = adaptive
version = 1.0.0
author = WinGuard Team
description = Adaptive isolation policy: starts in LEVEL 0 and dynamically tightens Job and security limits upon runtime violations

[security]
initial_level = LEVEL_0_OBSERVE

[limits]
max_processes = 10
max_memory_mb = 256
cpu_rate_cap_percent = 50
cpu_hard_cap = true

[token]
use_restricted_token = false
strip_admin_sids = true
disable_all_privileges = false
integrity_level = Medium

[filesystem]
sandbox_root = sandbox
read_only_paths = sandbox\input
read_write_paths = sandbox\output;sandbox\temp
denied_paths = C:\Windows;C:\Program Files

[adaptive]
escalation_threshold = 2
decay_interval_sec = 10
decay_step = 1
auto_terminate_on_l3 = true
