# WinGuard Security Policy: Compute Workload
# Purpose: Dynamic policy with elastic throttling & multi-signal correlation for heavy compute / builds / simulations

[metadata]
name = compute_workload
version = 2.0.0
author = WinGuard Team
description = Workload-aware policy preventing false positive clamping during heavy compile and simulation jobs

[security]
initial_level = LEVEL_0_OBSERVE

[limits]
max_processes = 16
max_memory_mb = 512
cpu_rate_cap_percent = 80
cpu_hard_cap = false

[token]
use_restricted_token = false
strip_admin_sids = true
disable_all_privileges = false
integrity_level = Medium

[filesystem]
sandbox_root = sandbox
read_only_paths = sandbox\input
read_write_paths = sandbox\output;sandbox\temp
denied_paths = C:\Windows;C:\Program Files

[adaptive]
escalation_threshold = 3
decay_interval_sec = 8
decay_step = 1
auto_terminate_on_l3 = true
workload_type = compute_batch
elastic_throttling = true
ignore_pure_compute_spikes = false
min_productive_io_mb_s = 1.0
